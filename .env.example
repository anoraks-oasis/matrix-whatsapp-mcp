# matrix-whatsapp-mcp configuration (copy to .env and fill in real values).

# Required. Matrix homeserver base URL.
MATRIX_HOMESERVER=https://homeserver.example.com

# Required. The bot's Matrix user ID, e.g. @bot:example.com.
MATRIX_USER_ID=@bot:example.com

# Required. The bot's access token. Keep this secret.
MATRIX_ACCESS_TOKEN=

# End-to-end encryption. When enabled, MATRIX_PICKLE_KEY is required and the
# crypto state is stored at MATRIX_CRYPTO_DB_PATH (default: matrix-crypto.db).
MATRIX_E2EE_ENABLED=false
MATRIX_CRYPTO_DB_PATH=matrix-crypto.db
MATRIX_PICKLE_KEY=

# Optional. POST incoming messages to this URL (JSON, 5s timeout, 1 retry).
TRIGGER_WEBHOOK_URL=

# Comma-separated room IDs allowed to receive outbound messages.
# Empty means read-only mode: sending is disabled (fails closed).
ALLOWED_SEND_ROOMS=

# MCP transport: stdio (default) or http.
MCP_TRANSPORT=stdio

# Listen address when MCP_TRANSPORT=http.
HTTP_ADDR=:8080
