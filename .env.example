# matrix-whatsapp-mcp configuration (copy to .env and fill in real values).

# Required. Matrix homeserver base URL.
MATRIX_HOMESERVER=https://homeserver.example.com

# Required. The bot's Matrix user ID, e.g. @bot:example.com.
MATRIX_USER_ID=@bot:example.com

# Required. The bot's access token. Keep this secret.
MATRIX_ACCESS_TOKEN=

# End-to-end encryption. When enabled, MATRIX_PICKLE_KEY is required and the
# crypto state is stored at MATRIX_CRYPTO_DB_PATH (default: matrix-crypto.db).
MATRIX_E2EE_ENABLED=false
MATRIX_CRYPTO_DB_PATH=matrix-crypto.db
MATRIX_PICKLE_KEY=

# Optional. POST incoming messages to this URL (JSON, 5s timeout, 1 retry).
TRIGGER_WEBHOOK_URL=

# How long a send waits for the bridge to confirm it forwarded the message
# (default: 1s, "0" disables the check). Bridges post an m.notice into the room
# when they reject a message, e.g. because relay mode is not configured for the
# sender's account; with the check on, such a send is reported as a failure.
MATRIX_BRIDGE_ACK_TIMEOUT=1s

# Comma-separated room IDs allowed to receive outbound messages. Unioned with
# MATRIX_ALLOWLIST_FILE. Both empty means read-only mode: sending is disabled
# (fails closed).
ALLOWED_SEND_ROOMS=

# Room IDs allowed to receive outbound messages, one per line, '#' comments
# allowed. `matrix-whatsapp-mcp rooms allow` writes this file, and the running
# server re-reads it, so no restart is needed. Default:
# $XDG_CONFIG_HOME/matrix-whatsapp-mcp/allow.txt, else
# ~/.config/matrix-whatsapp-mcp/allow.txt.
MATRIX_ALLOWLIST_FILE=

# Accept room invitations automatically (default: false). The invitation still
# has to be sent from Element; this only removes the manual accept. Each join
# and each refusal is logged to stderr.
MATRIX_AUTO_JOIN_INVITES=false

# Comma-separated user IDs whose invitations may be accepted automatically.
# Empty means accept from anyone.
MATRIX_INVITE_ALLOWLIST=

# MCP transport: stdio (default) or http.
MCP_TRANSPORT=stdio

# Listen address when MCP_TRANSPORT=http.
HTTP_ADDR=:8080
