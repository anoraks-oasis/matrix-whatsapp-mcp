# EnvironmentFile for deploy/matrix-whatsapp-mcp.service.
# Install as /srv/matrix/matrix-whatsapp-mcp/etc/env, mode 0640, owner
# root:matrix-mcp. The full list of variables, with defaults, is in the README.

MATRIX_HOMESERVER=https://matrix.example.com
MATRIX_USER_ID=@bot:example.com
MATRIX_ACCESS_TOKEN=YOUR_ACCESS_TOKEN

# The service runs with ProtectHome=true, so the allowlist path must be explicit:
# there is no $HOME to fall back to, and the CLI and the service have to resolve
# the same file.
MATRIX_ALLOWLIST_FILE=/srv/matrix/matrix-whatsapp-mcp/state/allow.txt

# A systemd unit has no client on stdin, so serve Streamable HTTP instead.
# Bind the host's private-network address when the MCP client is another machine
# on that network, 127.0.0.1 when it is on this host. Keep it off the internet:
# the listener has no authentication in front of it.
MCP_TRANSPORT=http
HTTP_ADDR=127.0.0.1:8080

# Optional
# TRIGGER_WEBHOOK_URL=https://example.com/hooks/wa
# MATRIX_AUTO_JOIN_INVITES=true
# MATRIX_INVITE_ALLOWLIST=@you:example.com
# MATRIX_BRIDGE_ACK_TIMEOUT=1s
# MATRIX_E2EE_ENABLED=true
# MATRIX_CRYPTO_DB_PATH=/srv/matrix/matrix-whatsapp-mcp/state/matrix-crypto.db
# MATRIX_PICKLE_KEY=YOUR_PICKLE_KEY
