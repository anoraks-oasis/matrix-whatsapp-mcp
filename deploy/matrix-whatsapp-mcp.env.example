# EnvironmentFile for deploy/matrix-whatsapp-mcp.service.
# Install as /etc/matrix-whatsapp-mcp/env, mode 0640, owner root:matrix-mcp.
# The full list of variables, with defaults, is in the README.

MATRIX_HOMESERVER=https://matrix.example.com
MATRIX_USER_ID=@bot:example.com
MATRIX_ACCESS_TOKEN=YOUR_ACCESS_TOKEN

# The service runs with ProtectHome=true, so the allowlist path must be explicit
# and must match the path used by `chats allow`.
MATRIX_ALLOWLIST_FILE=/var/lib/matrix-whatsapp-mcp/allow.txt

# A systemd unit has no client on stdin, so serve Streamable HTTP instead.
MCP_TRANSPORT=http
HTTP_ADDR=127.0.0.1:8080

# Optional
# TRIGGER_WEBHOOK_URL=https://example.com/hooks/wa
# MATRIX_AUTO_JOIN_INVITES=true
# MATRIX_INVITE_ALLOWLIST=@you:example.com
# MATRIX_BRIDGE_ACK_TIMEOUT=1s
# MATRIX_E2EE_ENABLED=true
# MATRIX_CRYPTO_DB_PATH=/var/lib/matrix-whatsapp-mcp/matrix-crypto.db
# MATRIX_PICKLE_KEY=YOUR_PICKLE_KEY
